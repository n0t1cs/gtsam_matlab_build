#!/bin/bash

# GTSAM build script with Python wrapper (no MATLAB).
# Builds + installs GTSAM C++ library AND the Python bindings.
# GTSAM_THROW_CHEIRALITY_EXCEPTION=OFF so SmartProjectionPoseFactor does not
# throw on cheirality during projection.

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

HOME_FOR_GTSAM="$HOME/GTSAM"
GTSAM_DIR="$HOME_FOR_GTSAM/gtsam"
BUILD_DIR="$GTSAM_DIR/build"
INSTALL_PREFIX="/usr/local"
GTSAM_TAG="4.2a9"
PY="python3"

echo -e "${GREEN}=== GTSAM build (library + Python wrapper) ===${NC}"

# --- Prerequisites ---
REQUIRED="cmake build-essential libboost-all-dev libtbb-dev python3-dev python3-pip python3-numpy"
MISSING=""
for pkg in $REQUIRED; do
  dpkg -l | grep -q "^ii $pkg" || MISSING="$MISSING $pkg"
done
if [ -n "$MISSING" ]; then
  echo -e "${YELLOW}Installing:$MISSING${NC}"
  sudo apt-get install -y $MISSING
fi

# pyparsing is required by gtwrap
$PY -c "import pyparsing" 2>/dev/null || {
  echo -e "${YELLOW}Installing pyparsing...${NC}"
  pip3 install --break-system-packages pyparsing 2>/dev/null || pip3 install --user pyparsing
}

# --- Source ---
if [ ! -d "$GTSAM_DIR" ]; then
  echo -e "${YELLOW}Cloning GTSAM into $GTSAM_DIR${NC}"
  mkdir -p "$HOME_FOR_GTSAM"
  cd "$HOME_FOR_GTSAM"
  git clone https://github.com/borglab/gtsam.git
fi

cd "$GTSAM_DIR"
git fetch --all --tags
git checkout "$GTSAM_TAG"
git submodule update --init --recursive

# --- gtwrap (Python module needed by the wrapper build) ---
echo -e "${GREEN}Installing gtwrap...${NC}"
cd "$GTSAM_DIR/wrap"
pip3 install --break-system-packages . 2>/dev/null || pip3 install --user .
$PY -c "import gtwrap; print('gtwrap OK')" || {
  echo -e "${RED}gtwrap import failed${NC}"
  exit 1
}

# --- Clean build dir ---
if [ -d "$BUILD_DIR" ]; then rm -rf "$BUILD_DIR"; fi
mkdir "$BUILD_DIR"
cd "$BUILD_DIR"

PY_VERSION=$($PY -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")

# --- Configure ---
echo -e "${GREEN}Configuring with CMake (Python ${PY_VERSION})...${NC}"
cmake \
  -DCMAKE_BUILD_TYPE=Release \
  -DGTSAM_BUILD_WITH_MARCH_NATIVE=OFF \
  -DGTSAM_THROW_CHEIRALITY_EXCEPTION=OFF \
  -DGTSAM_BUILD_PYTHON=ON \
  -DGTSAM_PYTHON_VERSION=$PY_VERSION \
  -DGTSAM_INSTALL_MATLAB_TOOLBOX=OFF \
  -DGTSAM_BUILD_TESTS=OFF \
  -DGTSAM_BUILD_EXAMPLES_ALWAYS=ON \
  -DGTSAM_BUILD_UNSTABLE=ON \
  -DCMAKE_INSTALL_PREFIX=$INSTALL_PREFIX \
  ..

echo -e "${GREEN}CMake configuration complete.${NC}"

# --- Build C++ library ---
NPROC=$(($(nproc) - 1))
[ $NPROC -lt 1 ] && NPROC=1
echo -e "${GREEN}Building C++ library with -j$NPROC ...${NC}"
make -j$NPROC

# --- Install C++ library ---
echo -e "${GREEN}Installing C++ library to $INSTALL_PREFIX ...${NC}"
sudo make install

# --- Build + install Python wrapper ---
echo -e "${GREEN}Building Python wrapper...${NC}"
make -j$NPROC python-install

# --- ldconfig ---
if ! grep -q "$INSTALL_PREFIX/lib" /etc/ld.so.conf.d/gtsam.conf 2>/dev/null; then
  sudo bash -c "echo $INSTALL_PREFIX/lib > /etc/ld.so.conf.d/gtsam.conf"
fi
sudo ldconfig

# --- Verify cheirality flag is off ---
CFG_HDR="$INSTALL_PREFIX/include/gtsam/config.h"
if [ -f "$CFG_HDR" ]; then
  if grep -E "^[[:space:]]*#define[[:space:]]+GTSAM_THROW_CHEIRALITY_EXCEPTION" "$CFG_HDR" >/dev/null; then
    echo -e "${RED}WARNING: GTSAM_THROW_CHEIRALITY_EXCEPTION still defined in $CFG_HDR${NC}"
    exit 1
  else
    echo -e "${GREEN}OK: GTSAM_THROW_CHEIRALITY_EXCEPTION is NOT defined in config.h${NC}"
  fi
fi

ldconfig -p | grep -q libgtsam.so && echo -e "${GREEN}OK: libgtsam registered in ldconfig${NC}"

# --- Verify Python module ---
if $PY -c "import gtsam; print('gtsam Python module OK, version:', gtsam.__version__ if hasattr(gtsam, '__version__') else '4.2a9')"; then
  echo -e "${GREEN}OK: gtsam Python module importable${NC}"
else
  echo -e "${RED}WARNING: gtsam Python module not importable${NC}"
fi

echo -e "\n${GREEN}Done. Next:${NC}"
echo "  cd ~/catkin_ws && catkin clean fuims_work && catkin build fuims_work"
